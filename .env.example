# Copy this file to .env and fill in your key. Never commit .env.

# --- The LLM: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_ai_studio_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Optional: run the agent or the eval through OmniRoute, a gateway you run yourself
#     (start OmniRoute, connect a provider, then create a key under Dashboard -> Endpoints)
# OMNIROUTE_API_KEY=your_omniroute_endpoint_key_here
# OMNIROUTE_URL=http://localhost:20128/v1/chat/completions
# OMNIROUTE_MODEL=auto
# LLM_PROVIDER=omniroute         # gemini (default) or omniroute

# --- Inbox: mock = data/sample_emails/ (default), gmail = your real inbox, read-only
# INBOX=gmail

# --- Bill log: a Google Sheet if this is set, otherwise the CSV file below.
#     The id is the long part of the sheet's address: docs.google.com/spreadsheets/d/<THIS PART>/edit
# GOOGLE_SHEET_ID=

# --- Google sign-in files, used by Gmail and Google Sheets (see README)
# GOOGLE_CREDENTIALS_PATH=credentials.json
# GOOGLE_TOKEN_PATH=token.json

# --- Where the agent keeps its files
# MEMORY_PATH=data/bills.csv     # long-term memory when no Google Sheet is set
# TRACE_PATH=logs/trace.jsonl    # observability: one line per agent step
