# Copy to .env and fill in. Never commit .env, token.json, credentials.json, or key files.

# --- Model (local dev): free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_ai_studio_key_here
GEMINI_MODEL=gemini-3.8-flash
# Free tier is ~5 requests/min and ~20/day per model. Batch runs cost at most 2 requests
# (all emails in one, verify retries in one more); GEMINI_RPM paces anything beyond that.
GEMINI_RPM=5
# GEMINI_BATCH_SIZE=25
# GEMINI_RETRY_ATTEMPTS=5
# --- Model (GCP): setting GOOGLE_CLOUD_PROJECT switches to Vertex AI (no API key)
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# (on Vertex, remove GEMINI_RPM; quotas are per-project and much higher)

# --- fetch_emails (Gmail, read-only scope). MOCK_INBOX=1 reads data/sample_emails/ instead.
# MOCK_INBOX=1
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
# GMAIL_QUERY=newer_than:30d {invoice bill receipt "amount due" "payment due" subscription}
# GMAIL_MAX_RESULTS=25

# --- log_to_sheet: Google Sheet if set, else local CSV
# GOOGLE_SHEET_ID=the-long-id-from-the-sheet-url
# GOOGLE_APPLICATION_CREDENTIALS=service-account.json
SHEET_CSV_PATH=data/bills.csv

# --- currency: static table (default; reproducible) or live daily ECB rates via frankfurter.dev
# FX_SOURCE=live

# --- flag_anomalies history: firestore or local JSON
# HISTORY_BACKEND=firestore
# FIRESTORE_COLLECTION=vendor_history
HISTORY_PATH=data/history.json
ANOMALY_WINDOW_MONTHS=3
ANOMALY_THRESHOLD_PCT=20
ANOMALY_MIN_HISTORY=2
