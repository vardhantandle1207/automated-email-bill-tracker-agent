# Copy this file to .env and fill in your key. Never commit .env.

# --- The LLM: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_ai_studio_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Optional: run the agent or the eval through OpenRouter (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# LLM_PROVIDER=openrouter        # gemini (default) or openrouter

# --- Inbox: mock = data/sample_emails/ (default), gmail = your real inbox, read-only
# INBOX=gmail
# GMAIL_CREDENTIALS_PATH=credentials.json
# GMAIL_TOKEN_PATH=token.json

# --- Where the agent keeps its files
# MEMORY_PATH=data/bills.csv     # long-term memory: one row per logged bill
# TRACE_PATH=logs/trace.jsonl    # observability: one line per agent step
